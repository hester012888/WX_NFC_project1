.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(255, 253, 247, 0.97);
  border-top: 1rpx solid rgba(18, 45, 49, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -12rpx 40rpx rgba(8, 45, 47, 0.08);
}

.tabbar-inner {
  position: relative;
  height: 112rpx;
  display: flex;
  align-items: stretch;
  padding: 0 12rpx;
}

.tabbar-inner::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  width: 88rpx;
  height: 3rpx;
  transform: translateX(-50%);
  border-radius: 0 0 4rpx 4rpx;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity: 0.7;
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8fa3a4;
  transition: color 0.2s ease;
}

.tab-hover {
  opacity: 0.72;
}

.tab-item.is-active {
  color: var(--teal-700);
}

.tab-text {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.tab-item.is-active .tab-text {
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 12rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--gold);
  opacity: 0;
  transform: scale(0.4);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.tab-item.is-active .tab-indicator {
  opacity: 1;
  transform: scale(1);
  box-shadow: 0 0 0 6rpx rgba(217, 164, 65, 0.16);
}

.tab-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  color: inherit;
  transition: transform 0.24s cubic-bezier(.2,.8,.2,1);
}

.tab-item.is-active .tab-icon {
  transform: translateY(-3rpx) scale(1.08);
}

/* 首页：古城门轮廓 */
.icon-home {
  width: 34rpx;
  height: 24rpx;
  margin-top: 10rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 3rpx 3rpx 6rpx 6rpx;
}

.icon-home::before {
  content: "";
  position: absolute;
  left: -6rpx;
  top: -14rpx;
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-bottom: 16rpx solid currentColor;
}

.icon-home::after {
  content: "";
  position: absolute;
  left: 9rpx;
  bottom: 0;
  width: 10rpx;
  height: 14rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: currentColor;
  opacity: 0.55;
}

