PORT=3000
CORS_ORIGIN=*
DB_PATH=./data/nfc-tourism.db
NODE_ENV=development
# 生产环境如需显式迁移，请设置 ALLOW_PROD_MIGRATE=1 并先完成备份

# 微信登录：开发阶段使用 mock，真机联调改为 real 并填写服务端密钥
WX_AUTH_MODE=mock
WX_APPID=
WX_APPSECRET=
SESSION_TTL_MS=604800000
GUEST_TTL_MS=2592000000

# UID 管理接口额外访问令牌（可选，用于可信内网以外的运维调用）
NFC_ADMIN_TOKEN=
