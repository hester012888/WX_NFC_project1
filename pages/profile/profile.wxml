<view class="page">
  <navigation-bar title="个人中心" back="{{false}}" color="#17313a" background="#ffffff" />

  <view class="hero profile-hero">
    <view class="avatar">游</view>
    <view class="profile-info">
      <view class="profile-name">文旅探索者</view>
      <view class="profile-id">ID: {{profile.visitorId || '--'}}</view>
    </view>
    <view class="profile-level">探索者</view>
  </view>

  <view class="content">
    <view class="card profile-stats">
      <view class="pstat">
        <text class="pstat-num">{{stats.checked}}</text>
        <text class="pstat-label">打卡点位</text>
      </view>
      <view class="pstat">
        <text class="pstat-num">{{stats.badges}}</text>
        <text class="pstat-label">获得徽章</text>
      </view>
      <view class="pstat">
        <text class="pstat-num">{{stats.progress}}%</text>
        <text class="pstat-label">活动进度</text>
      </view>
    </view>

    <view class="section-head">
      <text class="section-title">打卡记录</text>
      <text class="section-desc">共 {{checkins.length}} 条</text>
    </view>
    <view class="card history-card">
      <view wx:if="{{checkins.length === 0}}" class="history-empty">
        <view class="history-empty-icon">◎</view>
        <view>还没有打卡记录</view>
        <view class="history-empty-tip">去地图上找一个点位开始探索吧</view>
      </view>
      <view wx:for="{{checkins}}" wx:key="spotId" class="history-item">
        <view class="history-dot">✓</view>
        <view class="history-body">
          <view class="history-name">{{item.spotName}}</view>
          <view class="history-time">{{item.timeText}} · 到访打卡</view>
        </view>
      </view>
    </view>

    <view class="section-head">
      <text class="section-title">快捷入口</text>
    </view>
    <view class="card menu-card">
      <view
        wx:for="{{menus}}"
        wx:key="id"
        class="menu-item"
        data-url="{{item.url}}"
        data-tab="{{item.tab}}"
        bindtap="onMenuTap"
        hover-class="menu-item--hover"
      >
        <view class="menu-title">{{item.title}}</view>
        <view class="menu-desc">{{item.desc}}</view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="reset-btn" bindtap="onReset">重置演示数据</view>
    <view class="profile-footer">NFC 文旅互动打卡 · 第一阶段基础版</view>
  </view>
</view>
