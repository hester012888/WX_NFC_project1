<view class="page map-page">
  <navigation-bar title="探索地图" back="{{false}}" color="#17313a" background="#ffffff" />

  <view class="map-shell">
    <view class="map-frame">
      <map
        class="map"
        latitude="{{center.latitude}}"
        longitude="{{center.longitude}}"
        scale="14"
        markers="{{markers}}"
        polyline="{{polyline}}"
        show-location="{{false}}"
        enable-zoom="{{true}}"
        enable-scroll="{{true}}"
        bindmarkertap="onMarkerTap"
      ></map>

      <view class="map-shade"></view>

      <view class="map-hud anim-fade">
        <view class="hud-compass">
          <view class="compass-needle"></view>
          <text class="compass-letter">N</text>
        </view>
        <view class="hud-copy">
          <view class="hud-kicker">EXPLORATION MAP</view>
          <view class="hud-title display">{{mapMeta.count}} 处城市坐标</view>
          <view class="hud-sub">已抵达 {{stats.checked}} 处 · {{mapMeta.coord}}</view>
        </view>
      </view>

      <view class="map-legend">
        <view class="legend-item"><view class="legend-dot legend-dot--done"></view>已打卡</view>
        <view class="legend-item"><view class="legend-dot"></view>待探索</view>
      </view>

      <view class="map-tip">点击地图标记，读取点位故事</view>
    </view>
  </view>

  <view class="map-content">
    <view class="route-intro">
      <view class="route-intro-line"></view>
      <view class="route-intro-body">
        <view class="eyebrow">SUGGESTED ROUTE</view>
        <view class="route-heading display">推荐探索路线</view>
        <view class="route-sub">沿序号依次到访，串起一整座城市的记忆</view>
      </view>
      <view class="route-progress">
        <text class="route-progress-num">{{stats.checked}}</text>
        <text class="route-progress-sep">/</text>
        <text class="route-progress-total">{{stats.total}}</text>
      </view>
    </view>

    <view class="route-track">
      <view class="route-step pressable" wx:for="{{spots}}" wx:key="id" data-id="{{item.id}}" bindtap="goSpot" hover-class="route-step--hover" hover-stay-time="100">
        <view class="step-rail">
          <view class="step-dot {{item.checked ? 'step-dot--done' : ''}}">{{item.checked ? '✓' : item.order}}</view>
          <view wx:if="{{index < spots.length - 1}}" class="step-line"></view>
        </view>
        <view class="step-body">
          <view class="step-topline">
            <text class="step-index">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</text>
            <text class="step-name display">{{item.name}}</text>
          </view>
          <view class="step-desc ellipsis">{{item.summary}}</view>
          <view class="step-tag">{{item.category}}</view>
        </view>
        <view class="step-action">
          <view class="step-action-line"></view>
          <text class="step-arrow">›</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!loading && spots.length === 0}}" class="empty">暂无点位数据</view>

    <view class="btn-ghost route-bottom pressable" bindtap="goActivity" hover-class="route-bottom--hover">
      查看活动详情
      <text class="route-bottom-arrow">↗</text>
    </view>
  </view>
</view>
