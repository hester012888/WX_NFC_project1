<view class="page">
  <navigation-bar title="探索地图" back="{{false}}" color="#17313a" background="#ffffff" />

  <view class="map-wrap">
    <map
      class="map"
      latitude="{{center.latitude}}"
      longitude="{{center.longitude}}"
      scale="14"
      markers="{{markers}}"
      polyline="{{polyline}}"
      show-location="{{false}}"
      enable-zoom="{{true}}"
      enable-scroll="{{true}}"
      bindmarkertap="onMarkerTap"
    ></map>
    <view class="map-tip">点击地图标记，查看点位故事</view>
  </view>

  <view class="content">
    <view class="card route-card">
      <view class="route-head">
        <view>
          <view class="route-title">推荐探索路线</view>
          <view class="route-sub">按序号依次打卡，路线更顺畅</view>
        </view>
        <view class="route-progress">{{stats.checked}}/{{stats.total}}</view>
      </view>
      <view class="route-track">
        <view class="route-step" wx:for="{{spots}}" wx:key="id" data-id="{{item.id}}" bindtap="goSpot" hover-class="route-step--hover">
          <view class="step-rail">
            <view class="step-dot {{item.checked ? 'step-dot--done' : ''}}">{{item.checked ? '✓' : item.order}}</view>
            <view wx:if="{{index < spots.length - 1}}" class="step-line"></view>
          </view>
          <view class="step-body">
            <view class="step-name">{{item.name}}</view>
            <view class="step-desc ellipsis">{{item.summary}}</view>
            <view class="step-tag">{{item.category}}</view>
          </view>
          <text class="step-arrow">›</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!loading && spots.length === 0}}" class="empty">暂无点位数据</view>

    <view class="btn-ghost route-bottom" bindtap="goActivity">查看活动详情</view>
  </view>
</view>
