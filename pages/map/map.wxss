.map-shell {
  padding: 24rpx 24rpx 0;
}

.map-frame {
  position: relative;
  height: 660rpx;
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(18,45,49,0.12);
  box-shadow: 0 26rpx 60rpx rgba(8,45,47,0.16);
  background: #e9eee9;
}

.map {
  width: 100%;
  height: 100%;
  display: block;
}

.map-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(5,46,48,0.34) 0%, transparent 32%),
    linear-gradient(0deg, rgba(5,46,48,0.24) 0%, transparent 30%);
}

.map-hud {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  right: 24rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255,253,247,0.92);
  border: 1rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 16rpx 40rpx rgba(4,32,34,0.18);
}

.hud-compass {
  position: relative;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  border-radius: 50%;
  border: 2rpx solid rgba(13,108,100,0.35);
  background: radial-gradient(circle, #ffffff 0%, #eef4ee 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.compass-needle {
  position: absolute;
  left: 28rpx;
  top: 10rpx;
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-bottom: 22rpx solid var(--teal-700);
  transform-origin: 50% 23rpx;
  animation: float-soft 4s ease-in-out infinite;
}

.compass-letter {
  position: absolute;
  bottom: 6rpx;
  font-size: 16rpx;
  font-weight: 700;
  color: var(--teal-800);
}

.hud-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.hud-kicker {
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: var(--gold-deep);
}

.hud-title {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
}

.hud-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.map-legend {
  position: absolute;
  right: 22rpx;
  top: 132rpx;
  z-index: 4;
  display: flex;
  flex-direction: column;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255,253,247,0.9);
  box-shadow: 0 12rpx 30rpx rgba(4,32,34,0.16);
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 19rpx;
  color: var(--ink-2);
}

.legend-item + .legend-item {
  margin-top: 10rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid var(--teal-500);
}

.legend-dot--done {
  background: var(--teal-700);
  border-color: var(--teal-700);
  box-shadow: 0 0 0 4rpx rgba(13,108,100,0.14);
}

.map-tip {
  position: absolute;
  left: 22rpx;
  bottom: 22rpx;
  z-index: 4;
  padding: 10rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255,253,247,0.92);
  color: var(--ink-2);
  font-size: 21rpx;
  box-shadow: 0 8rpx 22rpx rgba(4,32,34,0.16);
}

.map-content {
  padding: 36rpx 32rpx 40rpx;
}

.route-intro {
  display: flex;
  align-items: center;
}

.route-intro-line {
  width: 6rpx;
  height: 92rpx;
  flex: none;
  border-radius: 6rpx;
  background: linear-gradient(180deg, var(--gold), var(--teal-700));
}

.route-intro-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.route-heading {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.route-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.route-progress {
  flex: none;
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  border-radius: 22rpx;
  background: var(--teal-100);
  color: var(--teal-800);
}

.route-progress-num {
  font-family: var(--display-font);
  font-size: 34rpx;
  font-weight: 700;
}

.route-progress-sep {
  margin: 0 6rpx;
  opacity: 0.5;
}

.route-progress-total {
  font-size: 22rpx;
}

.route-track {
  margin-top: 26rpx;
}

.route-step {
  display: flex;
  align-items: stretch;
  min-height: 152rpx;
  padding: 18rpx 20rpx 18rpx 12rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fffdf8, #ffffff);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-soft);
}

.route-step--hover {
  background: #f8f7f1;
}

.step-rail {
  width: 64rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-dot {
  width: 46rpx;
  height: 46rpx;
  flex: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--teal-100);
  color: var(--teal-800);
  font-family: var(--display-font);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: inset 0 0 0 1rpx rgba(13,108,100,0.14);
}

.step-dot--done {
  background: var(--teal-700);
  color: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(13,108,100,0.12);
}

.step-line {
  flex: 1;
  width: 1rpx;
  min-height: 48rpx;
  margin-top: 8rpx;
  background: repeating-linear-gradient(to bottom, var(--line-strong) 0 8rpx, transparent 8rpx 16rpx);
}

.step-body {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.step-topline {
  display: flex;
  align-items: baseline;
}

.step-index {
  margin-right: 14rpx;
  font-family: var(--display-font);
  font-size: 22rpx;
  color: var(--gold-deep);
}

.step-name {
  font-size: 29rpx;
  font-weight: 700;
}

.step-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.step-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 14rpx;
  background: #f0f4ef;
  color: var(--ink-2);
  font-size: 19rpx;
}

.step-action {
  align-self: center;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-left: 12rpx;
}

.step-action-line {
  width: 32rpx;
  height: 1rpx;
  background: var(--line-strong);
}

.step-arrow {
  margin-top: -12rpx;
  font-size: 38rpx;
  line-height: 1;
  color: var(--teal-700);
}

.route-bottom {
  margin-top: 30rpx;
}

.route-bottom-arrow {
  margin-left: 12rpx;
  font-size: 28rpx;
}

.route-bottom--hover {
  opacity: 0.9;
}
