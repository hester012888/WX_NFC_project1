.map-wrap {
  position: relative;
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}

.map {
  width: 100%;
  height: 620rpx;
  display: block;
}

.map-tip {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  color: var(--ink-soft);
  font-size: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(18, 67, 74, 0.12);
}

.content {
  padding-top: 32rpx;
}

.route-card {
  padding: 28rpx 24rpx;
}

.route-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid var(--line);
}

.route-title {
  font-size: 32rpx;
  font-weight: 700;
}

.route-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.route-progress {
  padding: 8rpx 18rpx;
  border-radius: 22rpx;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 24rpx;
  font-weight: 600;
}

.route-track {
  padding-top: 12rpx;
}

.route-step {
  display: flex;
  align-items: stretch;
  padding: 16rpx 0;
}

.route-step--hover {
  opacity: 0.7;
}

.step-rail {
  width: 60rpx;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dot--done {
  background: var(--primary);
  color: #ffffff;
}

.step-line {
  flex: 1;
  width: 2rpx;
  min-height: 40rpx;
  background: var(--line);
}

.step-body {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.step-name {
  font-size: 28rpx;
  font-weight: 600;
}

.step-desc {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.step-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  background: #f0f5f5;
  color: var(--ink-soft);
  font-size: 20rpx;
}

.step-arrow {
  align-self: center;
  padding-left: 12rpx;
  color: #a8b8bd;
  font-size: 40rpx;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

.route-bottom {
  margin-top: 28rpx;
}
