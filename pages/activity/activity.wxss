.activity-hero {
  padding-bottom: 110rpx;
}

.activity-head {
  position: relative;
  z-index: 2;
  padding: 30rpx 40rpx 0;
}

.activity-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: rgba(255, 255, 255, 0.65);
}

.activity-name {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.activity-slogan {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 3rpx;
}

.activity-meta {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
}

.meta-item {
  margin-right: 16rpx;
  margin-bottom: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
}

.content {
  margin-top: -58rpx;
  position: relative;
  z-index: 3;
}

.progress-card {
  padding: 28rpx 30rpx;
}

.progress-top,
.progress-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-label {
  font-size: 28rpx;
  font-weight: 600;
}

.progress-value {
  font-size: 24rpx;
  color: var(--primary-deep);
}

.progress-track {
  height: 14rpx;
  margin: 20rpx 0 14rpx;
  border-radius: 10rpx;
  background: #eef4f4;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, var(--primary), #55c9b7);
  transition: width 0.4s ease;
}

.progress-bottom {
  font-size: 22rpx;
  color: var(--muted);
}

.progress-percent {
  color: var(--primary);
  font-weight: 600;
}

.text-card {
  padding: 28rpx 30rpx;
}

.desc {
  font-size: 27rpx;
  line-height: 1.9;
  color: var(--ink-soft);
  text-align: justify;
}

.meta-item:last-child {
  margin-right: 0;
}

.rule-card {
  padding: 12rpx 28rpx;
}

.rule-item {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rule-item:last-child {
  border-bottom: 0;
}

.rule-index {
  width: 48rpx;
  height: 48rpx;
  flex: none;
  border-radius: 16rpx;
  background: var(--primary-soft);
  color: var(--primary-deep);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rule-body {
  margin-left: 20rpx;
}

.rule-title {
  font-size: 28rpx;
  font-weight: 600;
}

.rule-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.bottom-cta {
  margin-top: 36rpx;
}

.bottom-cta--hover {
  opacity: 0.88;
}
