.home-hero {
  padding-bottom: 92rpx;
}

.hero-body {
  position: relative;
  z-index: 2;
  padding: 48rpx 40rpx 0;
}

.hero-kicker {
  display: inline-block;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 24rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hero-title {
  margin-top: 28rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.hero-slogan {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.86);
  letter-spacing: 4rpx;
}

.hero-rule {
  width: 68rpx;
  height: 6rpx;
  margin: 28rpx 0 20rpx;
  border-radius: 4rpx;
  background: #f2b45c;
}

.hero-summary {
  max-width: 480rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.78);
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  margin-top: 36rpx;
  padding: 18rpx 34rpx;
  border-radius: 44rpx;
  background: #ffffff;
  color: #075f5c;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.12);
}

.hero-btn--hover {
  opacity: 0.88;
}

.hero-btn-arrow {
  margin-left: 18rpx;
  font-size: 36rpx;
  line-height: 1;
}

.nfc-orbit {
  position: absolute;
  right: -40rpx;
  bottom: 56rpx;
  width: 220rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.9;
}

.nfc-ring {
  position: absolute;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
}

.nfc-ring--one {
  width: 220rpx;
  height: 220rpx;
}

.nfc-ring--two {
  width: 160rpx;
  height: 160rpx;
}

.nfc-core {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.content {
  margin-top: -52rpx;
  position: relative;
  z-index: 3;
}

.stats-card {
  padding: 28rpx 24rpx 24rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-deep);
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.stat-sep {
  width: 1rpx;
  height: 52rpx;
  background: var(--line);
}

.progress-line {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
}

.progress-track {
  flex: 1;
  height: 12rpx;
  border-radius: 8rpx;
  background: #eef4f4;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--primary), #4fc3b4);
  transition: width 0.4s ease;
}

.progress-text {
  margin-left: 18rpx;
  font-size: 22rpx;
  color: var(--ink-soft);
  white-space: nowrap;
}

.quick-grid {
  display: flex;
}

.quick-item {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  padding: 26rpx 10rpx 22rpx;
  border-radius: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-item:last-child {
  margin-right: 0;
}

.quick-item--hover {
  background: #f6fbfa;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
}

.quick-icon--nfc {
  background: #e3f4f1;
  color: #0c8c86;
}

.quick-icon--map {
  background: #e8f0fa;
  color: #3f7bb5;
}

.quick-icon--badge {
  background: #fdf1de;
  color: #c98a2f;
}

.quick-title {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.quick-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}
