/**app.wxss - 「城市记忆」视觉系统：墨绿 / 暖纸 / 铜金**/

page {
  --teal-950: #052e30;
  --teal-900: #073b3b;
  --teal-800: #0a514d;
  --teal-700: #0d6c64;
  --teal-500: #12a293;
  --teal-300: #7dd3c2;
  --teal-100: #dff2ed;
  --gold: #d9a441;
  --gold-deep: #a87824;
  --gold-soft: #f5e8cc;
  --ink: #122d31;
  --ink-2: #32535a;
  --muted: #82989c;
  --paper: #f4f2eb;
  --paper-2: #fffdf7;
  --paper-3: #eeeae0;
  --line: rgba(18, 45, 49, 0.10);
  --line-strong: rgba(18, 45, 49, 0.18);
  --shadow-soft: 0 14rpx 40rpx rgba(12, 52, 54, 0.07);
  --shadow-lift: 0 28rpx 70rpx rgba(8, 45, 47, 0.16);
  --radius-lg: 34rpx;
  --radius-md: 24rpx;
  --radius-sm: 16rpx;
  --display-font: "Songti SC", "STSong", "Noto Serif SC", serif;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, image, scroll-view, button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.page--plain {
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

/* 通用排版 */
.display {
  font-family: var(--display-font);
  letter-spacing: 2rpx;
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
  color: var(--muted);
}

.muted {
  color: var(--muted);
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.hairline {
  height: 1rpx;
  background: var(--line);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 0 20rpx;
}

.section-title {
  position: relative;
  padding-left: 22rpx;
  font-family: var(--display-font);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 8rpx;
  height: 30rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, var(--gold), var(--gold-deep));
}

.section-desc {
  font-size: 22rpx;
  color: var(--muted);
}

/* 容器与按钮 */
.card {
  position: relative;
  background: var(--paper-2);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.content {
  padding: 28rpx 32rpx;
}

.btn-primary,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
}

.btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, var(--teal-800), var(--teal-500));
  box-shadow: 0 16rpx 34rpx rgba(13, 108, 100, 0.26), inset 0 1rpx 0 rgba(255,255,255,0.22);
}

.btn-ghost {
  color: var(--teal-800);
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(13, 108, 100, 0.32);
}

.btn-primary:active,
.btn-ghost:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: var(--teal-100);
  color: var(--teal-800);
  font-size: 21rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
}

/* Hero 通用气质 */
.hero {
  position: relative;
  overflow: hidden;
  color: #ffffff;
  background:
    radial-gradient(circle at 78% 18%, rgba(217, 164, 65, 0.22), transparent 32%),
    linear-gradient(135deg, var(--teal-950) 0%, var(--teal-800) 58%, var(--teal-700) 100%);
}

.hero::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.035) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
  opacity: 0.7;
  pointer-events: none;
}

.hero::after {
  content: "";
  position: absolute;
  right: -170rpx;
  top: -200rpx;
  width: 560rpx;
  height: 560rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  box-shadow: 0 0 0 70rpx rgba(255,255,255,0.035), 0 0 0 160rpx rgba(255,255,255,0.025);
  pointer-events: none;
}

/* 色彩：沿用业务 coverTone，重新调校更高级的渐变 */
.tone-teal { background: linear-gradient(140deg, #0b635f 0%, #16a596 100%); }
.tone-blue { background: linear-gradient(140deg, #22547d 0%, #5a9fc4 100%); }
.tone-amber { background: linear-gradient(140deg, #a97125 0%, #e5b968 100%); }
.tone-indigo { background: linear-gradient(140deg, #33427f 0%, #7785c4 100%); }
.tone-violet { background: linear-gradient(140deg, #5b3d87 0%, #a98ed0 100%); }
.tone-green { background: linear-gradient(140deg, #2f704f 0%, #83bf95 100%); }

/* 动效 */
@keyframes rise-in {
  from { opacity: 0; transform: translateY(28rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes float-soft {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes orbit-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes pulse-ring {
  0% { transform: scale(0.88); opacity: 0.85; }
  70% { transform: scale(1.12); opacity: 0; }
  100% { transform: scale(1.12); opacity: 0; }
}

@keyframes shine {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(220%); }
}

@keyframes modal-pop {
  from { opacity: 0; transform: translateY(40rpx) scale(0.94); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes draw-line {
  from { transform: scaleY(0); }
  to { transform: scaleY(1); }
}

.anim-rise { animation: rise-in 0.6s cubic-bezier(.2,.8,.2,1) both; }
.anim-fade { animation: fade-in 0.5s ease both; }
.anim-float { animation: float-soft 4.5s ease-in-out infinite; }
.pressable { transition: transform 0.18s ease, opacity 0.18s ease, background 0.18s ease; }
.pressable:active { transform: scale(0.97); opacity: 0.88; }

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 进度条宽度档位：避免在 WXML 中写内联 style */
.progress-w0 { width: 0%; }
.progress-w10 { width: 10%; }
.progress-w20 { width: 20%; }
.progress-w30 { width: 30%; }
.progress-w40 { width: 40%; }
.progress-w50 { width: 50%; }
.progress-w60 { width: 60%; }
.progress-w70 { width: 70%; }
.progress-w80 { width: 80%; }
.progress-w90 { width: 90%; }
.progress-w100 { width: 100%; }
