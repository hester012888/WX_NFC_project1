<view class="spot-card pressable" bindtap="onTap" hover-class="spot-card--hover" hover-stay-time="120">
  <view class="spot-plate tone-{{spot.coverTone}}">
    <view class="plate-grid"></view>
    <text class="plate-order">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</text>
    <text class="plate-mark">{{categoryMark}}</text>
    <view class="plate-orbit"></view>
  </view>

  <view class="spot-info">
    <view class="spot-topline">
      <text class="spot-category">{{spot.category || '文化点位'}}</text>
      <text wx:if="{{spot.checked}}" class="spot-checked">✓ 已到访</text>
    </view>
    <view class="spot-name display ellipsis">{{spot.name}}</view>
    <view class="spot-sub ellipsis">{{spot.subtitle}}</view>
    <view class="spot-meta">
      <text class="spot-tag" wx:for="{{spot.tags}}" wx:for-index="tagIndex" wx:key="*this" wx:if="{{tagIndex < 2}}">{{item}}</text>
    </view>
  </view>

  <view class="spot-arrow">
    <text class="arrow-line"></text>
    <text class="arrow-head">›</text>
  </view>
</view>
