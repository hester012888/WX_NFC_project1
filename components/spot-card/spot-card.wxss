.spot-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 176rpx;
  margin-bottom: 22rpx;
  padding: 22rpx 26rpx 22rpx 22rpx;
  background: linear-gradient(135deg, #fffdf8 0%, #ffffff 62%, #fbfaf5 100%);
  border: 1rpx solid rgba(18, 45, 49, 0.09);
  border-radius: 26rpx;
  box-shadow: 0 16rpx 44rpx rgba(12, 52, 54, 0.07);
  overflow: hidden;
}

.spot-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: 30rpx;
  width: 5rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: linear-gradient(180deg, var(--gold), transparent);
  opacity: 0.85;
}

.spot-card--hover {
  background: #f9f8f2;
  box-shadow: 0 22rpx 54rpx rgba(12, 52, 54, 0.12);
}

.spot-plate {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  flex: none;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 14rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.22), 0 10rpx 24rpx rgba(8, 60, 58, 0.18);
}

.plate-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.10) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.10) 1rpx, transparent 1rpx);
  background-size: 22rpx 22rpx;
}

.plate-order {
  position: relative;
  z-index: 2;
  color: rgba(255, 255, 255, 0.95);
  font-family: var(--display-font);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.plate-mark {
  position: absolute;
  left: 14rpx;
  top: 10rpx;
  z-index: 2;
  font-family: var(--display-font);
  font-size: 54rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.24);
}

.plate-orbit {
  position: absolute;
  right: -34rpx;
  top: -34rpx;
  width: 118rpx;
  height: 118rpx;
  border: 1rpx solid rgba(255,255,255,0.32);
  border-radius: 50%;
  box-shadow: 0 0 0 18rpx rgba(255,255,255,0.06);
}

.spot-info {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.spot-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.spot-category {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--gold-deep);
}

.spot-checked {
  font-size: 20rpx;
  color: var(--teal-700);
}

.spot-name {
  margin-top: 8rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
}

.spot-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.spot-meta {
  display: flex;
  margin-top: 12rpx;
}

.spot-tag + .spot-tag {
  margin-left: 10rpx;
}

.spot-tag {
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(13, 108, 100, 0.08);
  color: var(--teal-800);
  font-size: 19rpx;
}

.spot-arrow {
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  padding-left: 14rpx;
}

.arrow-line {
  width: 34rpx;
  height: 1rpx;
  background: var(--line-strong);
}

.arrow-head {
  margin-top: -12rpx;
  margin-right: -2rpx;
  color: var(--teal-700);
  font-size: 38rpx;
  line-height: 1;
}
